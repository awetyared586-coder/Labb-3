<Window x:Class="Labb_3code_along.Dialog.PackOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:Labb_3code_along.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3code_along.Dialog"
        mc:Ignorable="d"
        Title="PackOptionsDialog" Height="300" Width="350" 
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    
    <Grid>
        <StackPanel>
            <Label Content="Pack Name:"/>
            <TextBox x:Name="packNameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="10,0,10,5"/>

            <Label Content="Difficulty:" Margin="10,5,10,0"/>
            <ComboBox x:Name="difficultyComboBox"
                       SelectedValue="{Binding Difficulty}"
                       SelectedValuePath="Tag"
                       Margin="10,0,10,5">
         

                <ComboBoxItem Content="Easy"
                              Tag="{x:Static models:Difficulty.Easy}"/>
                  

                <ComboBoxItem Content="Medium"
                                Tag="{x:Static models:Difficulty.Medium}"/>
                

                <ComboBoxItem Content="Hard"
                                Tag="{x:Static models:Difficulty.Hard}"/>
              
            </ComboBox>

            <Label Content="Time Limit:" Margin="10,5,10,0"/>
            <Slider x:Name="timeLimitSlider" 
                    Minimum="10" 
                    Maximum="100" 
                    Value="{Binding TimeLimitInSeconds}" 
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    Margin="10,0,10,0"/>
            <TextBlock Text="{Binding ElementName=timeLimitSlider, Path=Value, StringFormat={}{0:F0} seconds}" 
                       HorizontalAlignment="Center"/>



        </StackPanel>
    </Grid>
</Window>
