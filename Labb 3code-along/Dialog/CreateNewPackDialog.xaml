<Window x:Class="Labb_3code_along.Dialog.CreateNewPackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3code_along.Dialog"
        mc:Ignorable="d"
        Title="CreateNewPackDialog" Height="230" Width="280" 
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <StackPanel>
        <Label Content="Pack Name:" Margin="10 0 10 10"/>
        <TextBox x:Name="packNameTextBox" Margin="10 0 10 5"/>
        
        <Label Content="Difficulty:" Margin="10,5,10,0"/>
        
        <ComboBox x:Name="difficultyComboBox"
                  SelectedIndex="1"
                  Margin=" 10,0,10,5" >
            <ComboBoxItem Content="Easy"/>
            <ComboBoxItem Content="Medium"/>
            <ComboBoxItem Content="Hard"/>
        </ComboBox>
        
        <Label Content="Time Limit:" Margin="10,5,10,0"/>
        <Slider x:Name="timeLimitSlider"
        Minimum="10"
        Maximum="100"
        Value="30"
        TickFrequency="10"
        IsSnapToTickEnabled="True"
        Margin="10,0,10,0"/>
        <TextBlock Text="{Binding ElementName=timeLimitSlider, Path=Value, StringFormat={}{0:F0} seconds}"
           HorizontalAlignment="Center"/>
        
        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="10">

            <Button Content="Cancel"
                    Width="80"
                    Margin="5"
                    IsCancel="True"/>
            <Button Content="Create"
                    Width="80"
                    Margin="5"
                    Click="CreatePackButton_Click"
                    IsDefault="True"/>



        </StackPanel>






    </StackPanel>
</Window>
