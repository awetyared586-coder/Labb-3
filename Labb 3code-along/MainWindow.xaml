<Window x:Class="Labb_3code_along.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Labb_3code_along.View"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3code_along"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!--<MenuItem.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Configu}"
    </MenuItem.InputBindings>-->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:Confugration Grid.Row="1">
            <views:Confugration.Style>
                <Style TargetType="{x:Type views:Confugration}">
                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsConfigurationMode,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                    Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:Confugration.Style>
        </views:Confugration>



    </Grid>
</Window>