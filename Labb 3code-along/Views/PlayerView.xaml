<UserControl x:Class="Labb_3code_along.View.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3code_along.View"
             mc:Ignorable="d" 
              DataContext="{Binding PlayerViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <StackPanel Visibility="{Binding IsQuizInProgress, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
            
            <TextBlock Text="{Binding QuestionProgress }"
                        FontSize="16"
                        Margin="5"/>
            <TextBlock Text="{Binding TimeRemaining}"
                       FontSize="16"
                       Margin="5" />

              </StackPanel>

            <TextBlock Text="{Binding CurrentQuestionText}"
                       FontSize="24"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="5,20"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Poäng:"/>
                <TextBlock Text="{Binding FeedbackSymbol}" 
                           FontSize="24"
                           Margin="5"/>
                <TextBlock Text="{Binding Score}"/>

               
            </StackPanel>

            
          <UniformGrid Rows="2" Columns="2">

             <Button Margin="5" Padding="10"
                         Command="{Binding AnswerCommand}"
                         CommandParameter="0" >
                 <Grid>
                    <TextBlock Text="{Binding ShuffledAnswers[0]}"/>
                    <TextBlock Text="{Binding FeedbackSymbols[0]}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               />
                

                 </Grid>

             </Button>

                <Button Margin="5" Padding="10"
                         Command="{Binding AnswerCommand}"
                         CommandParameter="1" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ShuffledAnswers[1]}"/>
                        <TextBlock Text="{Binding FeedbackSymbols[1]}"
                                    Margin="10 0 0 0"/>


                    </StackPanel>

                </Button>


                <Button Margin="5" Padding="10"
                         Command="{Binding AnswerCommand}"
                         CommandParameter="2" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ShuffledAnswers[2]}"/>
                        <TextBlock Text="{Binding FeedbackSymbols[2]}"
                                    Margin="10 0 0 0"/>


                    </StackPanel>

                </Button>


                <Button Margin="5" Padding="10"
                         Command="{Binding AnswerCommand}"
                         CommandParameter="3" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ShuffledAnswers[3]}"/>
                        <TextBlock Text="{Binding FeedbackSymbols[3]}"
                                    Margin="10 0 0 0"/>


                    </StackPanel>

                </Button>


            </UniformGrid>

            <Button Content="Nästa fråga" 
                    Command="{Binding NextQuestionCommand}"/>
           
        </StackPanel>

        <StackPanel Visibility="{Binding IsQuizFinished, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Klart!"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="{Binding FinalResult}"
                       FontSize="22"
                       Margin="10"/>
        </StackPanel>
        
    </Grid>
    
</UserControl>
