<UserControl x:Class="Labb_3code_along.View.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3code_along.View"
             mc:Ignorable="d" 
              DataContext="{Binding PlayerViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <StackPanel>

            <TextBlock  Text="{Binding QuestionProgress }"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        Margin="5"/>

            <TextBlock Text="{Binding CurrentQuestionText}"
                       FontSize="24"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="5,20"/>

            <TextBlock Text="Poäng: {Binding Score}"/>
            <TextBlock Text="Tid kvar:__"/>

            
          <UniformGrid Rows="2" Columns="2">
                <Button Content="{Binding CorrectAnswer}"
            Margin="5" Padding="10"
            Command="{Binding AnswerCommand}"
            CommandParameter="0"/>

                <Button Content="{Binding IncorrectAnswer1}"
            Margin="5" Padding="10"
            Command="{Binding AnswerCommand}"
            CommandParameter="1"/>

                <Button Content="{Binding IncorrectAnswer2}"
            Margin="5" Padding="10"
            Command="{Binding AnswerCommand}"
            CommandParameter="2"/>

                <Button Content="{Binding IncorrectAnswer3}"
            Margin="5" Padding="10"
            Command="{Binding AnswerCommand}"
            CommandParameter="3"/>


            </UniformGrid>





        </StackPanel>
        
    </Grid>
</UserControl>
