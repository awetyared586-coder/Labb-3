<UserControl x:Class="Labb_3code_along.View.Confugration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3code_along.View"
             mc:Ignorable="d" 
            DataContext="{Binding ConfigurationViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        
        
        <ListBox 
                  Grid.Column="0"
                  ItemsSource="{Binding ActivePack.Questions}"
                  SelectedItem="{Binding SelectedQuestion}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Query}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding SelectedQuestion.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="5" Text="{Binding SelectedQuestion.CorrectAnswer,  UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="5" Text="{Binding SelectedQuestion.IncorrectAnswers[0], UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="5" Text="{Binding SelectedQuestion.IncorrectAnswers[1], UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="5" Text="{Binding SelectedQuestion.IncorrectAnswers[2], UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>

    </Grid>
</UserControl>
