<UserControl x:Class="Labb_3code_along.View.Confugration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3code_along.View"
             mc:Ignorable="d" 
            DataContext="{Binding ConfigurationViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">

            <TextBlock Text="{Binding ActivePack.Name}"
               FontSize="20"
               Margin="20"/>

            <ListBox ItemsSource="{Binding ActivePack.Questions}"
             SelectedItem="{Binding SelectedQuestion, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Query}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>

        <StackPanel Grid.Column="1" 
                    IsEnabled="{Binding HasSelectedQuestion}">
            
            <TextBlock Text="Fråga:" Margin="20,70,10,0"/>
            <TextBox  Margin="20 0 10 20 " Text="{Binding SelectedQuestion.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Rätt svar:" Margin="50,10,50,0"/>
            <TextBox Margin="50 10 50 0 " Text="{Binding SelectedQuestion.CorrectAnswer,  Mode=TwoWay,  UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Felaktigt svar 1:" Margin="50,10,50,0"/>
            <TextBox Margin="50 10 50 0 " Text="{Binding SelectedQuestion.IncorrectAnswers[0], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Felaktigt svar 2:" Margin="50,10,50,0"/>
            <TextBox Margin="50 10 50 0 " Text="{Binding SelectedQuestion.IncorrectAnswers[1], Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Felaktigt svar 3:" Margin="50,10,50,0"/>
            <TextBox Margin="50 10 50 0 " Text="{Binding SelectedQuestion.IncorrectAnswers[2], Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>
        

    </Grid>
    
    
    
    
</UserControl>
