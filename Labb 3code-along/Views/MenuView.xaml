<UserControl x:Class="Labb_3code_along.View.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3code_along.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Grid>
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Question pack"
                          Command="{Binding CreateNewPackCommand}"/>
                <MenuItem Header="_Remove Question Pack"
                          Command="{Binding RemovePackCommand}"/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                
                <MenuItem Header="_Add Question"
                          InputGestureText="Ctrl+N"
                          Command="{Binding ConfigurationViewModel.AddQuestionCommand}"/>
                <MenuItem Header="_Remove Question"
                          InputGestureText="Delete"
                          Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}"/>
                <MenuItem Header="_Pack Options"
                          InputGestureText="Ctrl+O"
                          Command="{Binding PackOptionsCommand}"/>
                
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Edit"
                          Command="{Binding ShowConfigurationCommand}"/>
                <MenuItem Header="Play"
                          Command="{Binding ShowPlayerCommand}"/>
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="➕"
                    Command="{Binding ConfigurationViewModel.AddQuestionCommand}"
                    Margin="5"/>
            <Button Content="➖"
                    Command="{Binding ConfigurationViewModel.RemoveQuestionCommand}"
                    Margin="5"/>
            <Button Content="☰"
                    Command="{Binding PackOptionsCommand}"
                    Margin="5"/>



        </StackPanel>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
    </Grid>
    
</UserControl>
